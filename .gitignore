# ─── Tracciare CARTELLA ROOT per automation (per structure reproducibility) ───
!config/zap-home/security-zap-audit/
!config/zap-home/security-zap-audit/.gitkeep

# ─── Tracciare SOLO configurazioni permanenti (policies, scripts, reports, config core) ───
# Questi non cambiano e sono utilizzati da automation-script per setup iniziale
!config/zap-home/policies/
!config/zap-home/policies/**
!config/zap-home/scripts/
!config/zap-home/scripts/**
!config/zap-home/reports/
!config/zap-home/reports/**
!config/zap-home/config.xml

# ─── Cartella legacy (deprecata, escludere completamente) ───
config/zap-home/security-zap-audit-legacy/**

# ─── Uploads (user-generated content) ───
uploads/news/*
!uploads/news/.gitkeep

# ───Updater (tracciare solo file di configurazione e hash, escludere tutto il resto) ───
Updater/Files/*
!Updater/Files/.gitkeep
!Updater/Files/.htaccess
!Updater/Files/.hashes
!Updater/Files/.hashes/.htaccess
!Updater/Files/.hashes/.manifest.sha256
Updater/Files/.hashes/*.cache
Updater/Patches/*
!Updater/Patches/.gitkeep
!Updater/Patches/.hashes
!Updater/Patches/.hashes/.htaccess
!Updater/Patches/.hashes/.manifest.sha256
Updater/Patches/.hashes/*.cache

# ─── Build artifacts (non tracciare) ───
htdocs/*
htdocs.zip

# ─── Task Scheduler Worker (non tracciare) ───
worker.config.json
worker-config-sync.sql
worker-error.log

# ── Syncthing (il repo è in una share sync) ───────────
syncthing*
*.sync-conflict-*
.stfolder
.stversions

# ─── IDE & OS ───
.vscode/
.idea/
*.swp
*.swo
*~
Thumbs.db
Desktop.ini
.DS_Store

