# ─── Claude Code internal ───
.claude/

# ─── Sensitive / Environment ───
db.php
db_pdo.php

# ─── Htdocs (non tracciare, contiene build artifacts) ───
htdocs

# ─── Logs (runtime, non tracciare) ───
config/logs/*
!config/logs/.gitkeep

# ─── ZAP home directory: escludere TUTTO runtime ───
!config/zap-home/security-zap-audit/.gitkeep
config/zap-home/security-zap-audit/run-*
config/zap-home/security-zap-audit/db
config/zap-home/security-zap-audit/session
config/zap-home/security-zap-audit/addOnData
config/zap-home/security-zap-audit/hud
